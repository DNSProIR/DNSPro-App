<Window x:Class="DNSPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNSPro"
        Height="520" Width="440"
        MinHeight="420" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="DNSPro" FontSize="36" FontWeight="Bold" Foreground="#1A1A1A"/>
            <TextBlock x:Name="TaglineText"
                       Text="Fast, secure DNS for sanction access and Safe Family protection"
                       TextWrapping="Wrap" Foreground="#5F6368" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,28,0,0"
                   Text="Status: Inactive" FontSize="16" FontWeight="SemiBold" Foreground="#5F6368"/>

        <Button x:Name="ToggleButton" Grid.Row="2" Margin="0,20,0,0"
                Content="Enable DNSPro" Click="ToggleButton_Click"
                Height="52" FontSize="16" FontWeight="SemiBold" Cursor="Hand"
                Background="#0B5FFF" Foreground="White" BorderThickness="0"/>

        <Button x:Name="CheckButton" Grid.Row="3" Margin="0,12,0,0"
                Content="Check connection" Click="CheckButton_Click"
                Height="44" Cursor="Hand"
                Background="Transparent" BorderBrush="#0B5FFF" BorderThickness="1"
                Foreground="#0B5FFF"/>

        <TextBlock x:Name="MessageText" Grid.Row="4" Margin="0,16,0,0"
                   TextWrapping="Wrap" Foreground="#5F6368" FontSize="13"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <TextBlock Margin="0,0,16,0">
                <Hyperlink NavigateUri="https://dnspro.ir" RequestNavigate="Hyperlink_RequestNavigate">Website</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,0,16,0">
                <Hyperlink NavigateUri="https://t.me/dnspro_ir" RequestNavigate="Hyperlink_RequestNavigate">Telegram</Hyperlink>
            </TextBlock>
            <TextBlock>
                <Hyperlink NavigateUri="mailto:we@dnspro.ir" RequestNavigate="Hyperlink_RequestNavigate">Email</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
